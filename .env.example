# ---------------------------------------------------------------------------
# Copy to .env and fill in the values. The application validates this file at
# startup and refuses to boot with a message naming what is wrong.
# ---------------------------------------------------------------------------

# --- App ---
NODE_ENV=development
PORT=3000

# Publishes the API reference at /api/docs, which lists every route and
# payload shape. Keep it false in production.
SWAGGER_ENABLED=true

# Comma-separated origins allowed to call the API and the video socket.
# Required in production; empty in development permits any localhost port.
CORS_ORIGINS=http://localhost:5173

# --- Database ---
# The Prisma schema targets SQLite; a postgresql:// URL will not migrate.
DATABASE_URL="file:./dev.db"

# --- Auth ---
# At least 32 characters. Generate with: openssl rand -hex 32
# There is no default on purpose - a shared secret lets anyone sign an admin token.
JWT_SECRET=
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# --- Rate limiting ---
# Window in milliseconds and the number of requests allowed inside it.
# Sign-in attempts are counted separately, per account and per address, from
# the security-event log; see AuthService.login.
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
