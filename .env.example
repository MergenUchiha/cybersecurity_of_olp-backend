# ---------------------------------------------------------------------------
# Copy to .env and fill in the values. The application validates this file at
# startup and refuses to boot with a message naming what is wrong.
# ---------------------------------------------------------------------------

# --- App ---
NODE_ENV=development
PORT=3000

# Publishes the API reference at /api/docs, which lists every route and
# payload shape. Keep it false in production.
SWAGGER_ENABLED=true

# Comma-separated origins allowed to call the API and the video socket.
# Required in production; empty in development permits any localhost port.
CORS_ORIGINS=http://localhost:5173

# --- Database ---
# The Prisma schema targets SQLite; a postgresql:// URL will not migrate.
DATABASE_URL="file:./dev.db"

# --- Auth ---
# At least 32 characters. Generate with: openssl rand -hex 32
# There is no default on purpose - a shared secret lets anyone sign an admin token.
JWT_SECRET=
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# --- Video calls (WebRTC) ---
# STUN is enough when both peers can reach each other directly.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# A TURN relay is what makes calls work through a symmetric NAT. Leave both
# empty to run on STUN alone; set both to enable it.
#
# The backend hands the browser a credential that expires, so a leaked one
# stops working on its own. Configure coturn with:
#     use-auth-secret
#     static-auth-secret=<the same value as TURN_STATIC_AUTH_SECRET>
#     realm=<your domain>
TURN_HOST=
# At least 32 characters, and identical to coturn's static-auth-secret.
# Generate with: openssl rand -hex 32
TURN_STATIC_AUTH_SECRET=
# How long an issued credential stays valid, in seconds.
TURN_TTL_SECONDS=3600

# --- Rate limiting ---
# Window in milliseconds and the number of requests allowed inside it.
# Sign-in attempts are counted separately, per account and per address, from
# the security-event log; see AuthService.login.
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
